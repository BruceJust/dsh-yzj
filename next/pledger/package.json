{
  "name": "@yzj-next/pledger",
  "description": "The private ledger (vault): a SECOND store domain for the operator's own judgement — expectations, calibration receipts, gears and the rear-view mirror. Never referenced by the organization graph.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },

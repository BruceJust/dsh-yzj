{
  "name": "@yzj-next/tools",
  "description": "Model-facing Yunzhijia tools over the CLI bridge, plus the contract-bound approval guard that gates every write",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@yzj-next/bridge": "workspace:^",
    "@yzj-next/graph": "workspace:^",
    "@yzj-next/objects": "workspace:^",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}

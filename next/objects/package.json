{
  "name": "@yzj-next/objects",
  "description": "Graph object families as cordis plugins: approval (confirmation card + approval-seam answerer), with task/commitment to follow",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",

{
  "name": "@dsh-yzj/bridge",
  "description": "Host channel to the yzj-cli binary: bounded subprocess invocations that reuse the machine's yzj-cli login state",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery"
  }
}
